{
  "name": "unified-typography",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.13.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "jsdom": "^26.1.0",
    "@types/jsdom": "^21.1.7"
  },
  "dependencies": {
    "@lezer/markdown": "^1.4.3"
  },
  "license": "MIT",
  "description": "Unify body line height, source line break spacing, and heading sizes and spacing across reading view, Live Preview, and source mode.",
  "author": "Tychoon"
}
